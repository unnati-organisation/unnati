---
import { anchors } from "../data/anchors";
import "../styles/global.css";
import { siteName, absoluteURL, canonicalURL, breadcrumb } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = "UNNATI · Organisation for Development Education", description = "Promoting social inclusion and democratic governance across Western India.", image = "/images/logo-hi-full.png" } = Astro.props;

const siteUrl = Astro.site ?? new URL("https://www.unnati.org/");
const canonical = canonicalURL(siteUrl, Astro.url.pathname);
const ogImage = absoluteURL(siteUrl, image);
const root = absoluteURL(siteUrl, "/");
const crumbs = breadcrumb(siteUrl, Astro.url.pathname);

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${root}#organization`,
  name: siteName,
  url: root,
  logo: ogImage,
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+91-79-26746145",
    email: "psu_unnati@unnati.org",
    areaServed: "IN",
  },
};

const webSiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${root}#website`,
  url: root,
  name: siteName,
  publisher: { "@id": `${root}#organization` },
};

const breadcrumbJsonLd = crumbs
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.item,
      })),
    }
  : null;

const navLinks = [
  { label: "Home", href: "/" },
  { label: "About Us", href: "/about" },
  { label: "Thematic Anchors", href: "/thematic-anchors", children: anchors.map((a) => ({ label: a.nav, href: `/thematic-anchors/${a.slug}` })) },
  { label: "Resources", href: "/resources" },
  { label: "Accountability & Transparency", href: "/accountability-and-transparency", children: [
    { label: "Financials", href: "/accountability-and-transparency#financials" },
    { label: "Policies", href: "/accountability-and-transparency#policies" },
    { label: "Annual Reports", href: "/accountability-and-transparency#annual-reports" },
  ] },
  { label: "Contact", href: "/contact" },
];

const socials = [
  { label: "Facebook", href: "https://www.facebook.com/Unnati-102385968523618/", icon: "M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" },
  { label: "YouTube", href: "https://www.youtube.com/channel/UCxV9sbi0RYn4Vg-ya5N291g/videos", icon: "M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webSiteJsonLd)} />
    {breadcrumbJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
    <script is:inline>
      function googleTranslateElementInit() {
        if (window.google && window.google.translate) {
          new window.google.translate.TranslateElement(
            { pageLanguage: "en", includedLanguages: "en,hi,gu", autoDisplay: false },
            "google_translate_element"
          );
        }
      }
    </script>
    <script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" defer></script>
  </head>
  <body>
    <!-- Brand band -->
    <header class="border-b border-line bg-paper">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-8 px-5 py-4">
        <a href="/" class="flex items-center gap-3" aria-label="UNNATI home">
          <img src="/images/logo-hi-full.png" alt="UNNATI" class="h-16 w-auto" />
          <span class="flex flex-col justify-center">
            <span class="text-2xl font-bold leading-none tracking-tight text-charcoal">UNNATI</span>
            <span class="mt-1 hidden text-xs tracking-wide text-muted sm:block">Organisation for Development Education</span>
          </span>
        </a>
        <div class="flex items-center gap-3 sm:gap-5">
          <div id="google_translate_element" class="hidden" aria-hidden="true"></div>
          <div class="flex items-center gap-1 rounded-full border border-line bg-white p-1 shadow-card" role="group" aria-label="Choose language">
            <button type="button" class="lang-btn active" data-lang="en">EN</button>
            <button type="button" class="lang-btn" data-lang="hi">हिंदी</button>
            <button type="button" class="lang-btn" data-lang="gu">ગુજરાતી</button>
          </div>
          <div class="hidden gap-2 sm:flex">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full bg-charcoal text-xs font-semibold text-white transition duration-200 ease-in-out hover:bg-saffron-500 hover:text-charcoal" aria-label={s.label}><svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg></a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- Sticky nav band -->
    <div class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur-md transition-shadow duration-200 ease-in-out" id="siteHeaderNav">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 px-5 min-h-[60px]">
        <nav class="site-nav" aria-label="Primary">
          <ul class="nav-list m-0 flex list-none items-center gap-0.5 p-0">
            {navLinks.map((link) => (
              <li class={link.children ? "group relative" : "relative"}>
                <a href={link.href} class="block rounded-lg px-3.5 py-2 text-sm font-medium text-charcoal transition duration-200 ease-in-out hover:bg-saffron-50 hover:text-saffron-600">{link.label}</a>
                {link.children && (
                  <ul class="dropdown invisible absolute left-0 top-full z-50 min-w-[280px] list-none rounded-xl border border-line bg-white p-2 opacity-0 shadow-pop transition duration-200 ease-in-out group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                    {link.children.map((c) => (
                      <li><a href={c.href} class="block rounded-lg px-3 py-2 text-sm text-charcoal transition duration-200 ease-in-out hover:bg-saffron-50 hover:text-saffron-600">{c.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
        <button class="hamburger flex flex-col items-center justify-center gap-[5px] rounded-lg p-2 lg:hidden" id="hamburger" aria-label="Menu" aria-expanded="false">
          <span class="block h-0.5 w-6 rounded bg-charcoal"></span>
          <span class="block h-0.5 w-6 rounded bg-charcoal"></span>
          <span class="block h-0.5 w-6 rounded bg-charcoal"></span>
        </button>
      </div>
    </div>

    <slot />

    <footer class="bg-charcoal text-zinc-400">
      <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-10 px-5 py-14 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
        <div>
          <div class="mb-4 flex items-center gap-3">
            <img src="/images/logo-hi-mark-white.png" alt="" class="h-12 w-auto" />
            <span class="text-2xl font-bold leading-none text-white">UNNATI</span>
          </div>
          <p>Organisation for Development Education — promoting social inclusion and democratic governance across Western India since 1990.</p>
          <div class="mt-4 flex gap-2">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-xs font-semibold text-white transition duration-200 ease-in-out hover:bg-saffron-500 hover:text-charcoal" aria-label={s.label}><svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg></a>
            ))}
          </div>
        </div>

        <div>
          <h4 class="mb-4 text-base text-white">Explore</h4>
          <ul class="footer-links m-0 list-none space-y-2 p-0">
            <li><a href="/about" class="transition duration-200 ease-in-out hover:text-saffron-300">About Us</a></li>
            <li><a href="/thematic-anchors" class="transition duration-200 ease-in-out hover:text-saffron-300">Thematic Anchors</a></li>
            <li><a href="/resources" class="transition duration-200 ease-in-out hover:text-saffron-300">Resources</a></li>
            <li><a href="/accountability-and-transparency" class="transition duration-200 ease-in-out hover:text-saffron-300">Accountability & Transparency</a></li>
            <li><a href="/contact" class="transition duration-200 ease-in-out hover:text-saffron-300">Contact</a></li>
          </ul>
        </div>

        <div>
          <h4 class="mb-4 text-base text-white">Thematic Anchors</h4>
          <ul class="footer-links m-0 list-none space-y-2 p-0">
            {anchors.map((a) => (
              <li><a href={`/thematic-anchors/${a.slug}`} class="transition duration-200 ease-in-out hover:text-saffron-300">{a.nav}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h4 class="mb-4 text-base text-white">Head Office</h4>
          <address class="not-italic leading-relaxed text-zinc-400">
            UNNATI<br />
            216, Azad Society,<br />
            Ahmedabad 380 015, Gujarat (India)
          </address>
          <p class="mb-1 mt-3 text-saffron-300">+91-79-26746145 · 26733296</p>
          <p class="text-saffron-300">psu_unnati@unnati.org</p>
        </div>
      </div>

      <div class="border-t border-white/10 py-5">
        <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-4 px-5 text-sm">
          <span>© {new Date().getFullYear()} UNNATI. All rights reserved.</span>
          <span class="text-saffron-300">Core content in English · Materials also in हिंदी & ગુજરાતી</span>
        </div>
      </div>
    </footer>

    <script>
      const navBand = document.getElementById("siteHeaderNav");
      const ham = document.getElementById("hamburger");
      const nav = document.querySelector(".site-nav");
      if (ham && nav) {
        ham.addEventListener("click", () => {
          const open = nav.classList.toggle("open");
          ham.classList.toggle("open", open);
          ham.setAttribute("aria-expanded", String(open));
        });
      }
      const onScroll = () => {
        if (navBand) navBand.classList.toggle("scrolled", window.scrollY > 10);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
    <script is:inline>
      (function () {
        var KEY = "unnati-lang";
        var btns = Array.prototype.slice.call(document.querySelectorAll(".lang-btn"));
        var combo = null;
        function setActive(code) {
          btns.forEach(function (b) {
            b.classList.toggle("active", b.dataset.lang === code);
          });
        }
        function apply(code) {
          if (combo && combo.value !== code) {
            combo.value = code;
            combo.dispatchEvent(new Event("change", { bubbles: true }));
          }
        }
        btns.forEach(function (b) {
          b.addEventListener("click", function () {
            var code = b.dataset.lang;
            try { localStorage.setItem(KEY, code); } catch (e) {}
            setActive(code);
            apply(code);
          });
        });
        var saved = null;
        try { saved = localStorage.getItem(KEY); } catch (e) {}
        var tries = 0;
        var timer = setInterval(function () {
          combo = document.querySelector(".goog-te-combo");
          if (combo) {
            clearInterval(timer);
            if (saved && saved !== "en") { setActive(saved); apply(saved); } else { setActive("en"); }
          } else if (++tries > 40) {
            clearInterval(timer);
          }
        }, 500);
      })();
    </script>
  </body>
</html>
