---
import { Image } from "astro:assets";
import Layout from "./Layout.astro";
import { anchorBySlug, anchors } from "../data/anchors";
import { projectsForAnchor, anchorName } from "../data/projects";
import { img } from "../lib/images";
const base = import.meta.env.BASE_URL;

interface Props {
  slug: string;
  anchorTitle: string;
  heroTitle: string;
  intro: string;
  themes: { title: string; image: string; blurb: string; points?: string[] }[];
}
const { slug, anchorTitle, heroTitle, intro, themes } = Astro.props;

const anchor = anchorBySlug(slug);
const related = projectsForAnchor(slug);
---

<Layout title={`${anchorTitle} · UNNATI`} description={intro} image={anchor?.heroImage}>
  <section class="mx-auto w-full max-w-6xl px-5 pt-6">
    <div class="relative aspect-[4/3] overflow-hidden rounded-2xl shadow-pop sm:aspect-[16/9]">
      <Image
        src={img(anchor?.heroImage)}
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-top"
        widths={[600, 900, 1200, 1600]}
        sizes="100vw"
        format="webp"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/95 via-primary-dark/50 to-primary-dark/10"></div>
      <div class="relative z-10 flex h-full flex-col justify-end px-6 py-10 sm:px-10 sm:py-14">
        <div class="kicker mb-3 text-secondary-light">Thematic Anchor</div>
        <h1 class="max-w-3xl text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{heroTitle}</h1>
        <p class="mt-4 max-w-2xl text-zinc-200">{intro}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 pt-6">
    <nav class="flex flex-wrap gap-1.5 rounded-full border border-outline bg-surface-container-low p-1.5 shadow-card" aria-label="Thematic anchors">
      {anchors.map((a) => (
        <a
          href={`${base}thematic-anchors/${a.slug}`}
          class={a.slug === slug
            ? "rounded-full bg-saffron px-4 py-2 text-sm font-medium text-charcoal transition duration-200 ease-in-out"
            : "rounded-full px-4 py-2 text-sm font-medium text-on-surface-variant transition duration-200 ease-in-out hover:bg-saffron hover:text-charcoal"}
        >{a.nav}</a>
      ))}
    </nav>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-12">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {themes.map((t) => (
        <article class="card card-hover grid overflow-hidden md:grid-cols-[280px_1fr]">
          <div class="relative aspect-square overflow-hidden bg-inkdark md:aspect-auto">
            <Image
              src={img(t.image)}
              alt={t.title}
              class="absolute inset-0 h-full w-full object-cover object-top"
              widths={[480, 720, 960]}
              sizes="(min-width: 768px) 280px, 92vw"
              format="webp"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col p-6">
            <h3 class="mb-2 type-title text-on-surface">{t.title}</h3>
            <p class="mb-0 type-body text-muted">{t.blurb}</p>
            {t.points && t.points.length > 0 && (
              <ul class="mt-4 list-none space-y-1.5 p-0">
                {t.points.map((pt) => (
                  <li class="relative pl-5 type-body text-on-surface">
                    <span class="absolute left-0 top-[0.55em] h-2 w-2 rounded-full bg-saffron"></span>
                    {pt}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  {related.length > 0 && (
    <section class="bg-surface-container">
      <div class="mx-auto w-full max-w-6xl px-5 py-14">
        <div class="kicker mb-3">Projects</div>
        <h2 class="type-headline text-on-surface">Key Projects</h2>
        <p class="mb-0 mt-2 max-w-2xl text-muted">Key projects in this anchor — some also belong to other thematic anchors.</p>
        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
          {related.map((p) => (
            <a class="card card-hover flex flex-col overflow-hidden" href={`${base}projects/${p.slug}`}>
              <div class="relative aspect-[16/9] overflow-hidden bg-inkdark">
                <Image
                  src={img(p.image)}
                  alt={p.title}
                  class="absolute inset-0 h-full w-full object-cover object-top"
                  widths={[480, 720, 960, 1280]}
                  sizes="(min-width: 768px) 46vw, 92vw"
                  format="webp"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <div class="mb-3 flex flex-wrap gap-2">
                  <span class="chip">{p.period}</span>
                  <span class="chip">{p.support}</span>
                </div>
                <h3 class="mb-2 type-title text-on-surface">{p.title}</h3>
                <p class="mb-4 flex-1 type-body text-muted">{p.summary}</p>
                <div class="flex flex-wrap gap-1.5">
                  {p.tags.map((t) => <span class="rounded-full bg-primary-container px-3 py-1 text-xs font-medium text-on-primary-container">{anchorName(t)}</span>)}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
