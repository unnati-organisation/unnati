---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { anchors } from "../../data/anchors";
import { img } from "../../lib/images";
const base = import.meta.env.BASE_URL;
---

<Layout title="Thematic Anchors · UNNATI" description="UNNATI works through three thematic anchors: social inclusion, civic governance, and disaster risk reduction.">
  <section class="relative overflow-hidden bg-surface-container">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(circle at 88% 8%, rgba(107,64,40,0.12), transparent 46%), radial-gradient(circle at 4% 100%, rgba(107,64,40,0.08), transparent 40%);"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 py-14">
      <div class="kicker mb-4">Thematic Anchors</div>
      <h1 class="max-w-3xl text-4xl font-bold text-on-surface sm:text-5xl">Our three programme centres.</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        All activities are organised around three thematic anchors, spanning grassroots to policy level
        to ensure the basic rights of citizens.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-14">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {anchors.map((a) => (
        <a href={`${base}thematic-anchors/${a.slug}`} class="card card-hover group flex flex-col overflow-hidden">
          <div class="relative aspect-[4/3] overflow-hidden bg-inkdark">
            <Image
              src={img(a.image)}
              alt={a.title}
              class="media-fade absolute inset-0 h-full w-full object-cover object-top"
              widths={[400, 640, 960]}
              sizes="(min-width: 768px) 33vw, 92vw"
              format="webp"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="kicker mb-2 text-[0.6875rem]">{a.tagline}</div>
            <h3 class="mb-2 type-title text-on-surface">{a.title}</h3>
            <p class="mb-5 flex-1 type-body text-muted">{a.intro}</p>
            <span class="mt-auto inline-flex items-center gap-3 text-sm font-semibold text-primary">
              <span class="type-label">Explore</span>
              <span class="cta-icon" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
