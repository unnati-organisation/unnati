---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { offices } from "../data/site";
import { img } from "../lib/images";
---

<Layout title="Contact · UNNATI" description="Get in touch with UNNATI offices across Ahmedabad, Jodhpur, Kutch and New Delhi.">
  <section class="relative overflow-hidden bg-surface-container">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(circle at 88% 8%, rgba(107,64,40,0.12), transparent 46%), radial-gradient(circle at 4% 100%, rgba(107,64,40,0.08), transparent 40%);"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 py-14">
      <div class="kicker mb-4">Contact Us</div>
      <h1 class="max-w-3xl text-4xl font-bold text-on-surface sm:text-5xl">Reach our offices.</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        UNNATI works across Gujarat, Rajasthan and Delhi.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-12">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {offices.map((o) => (
        <div class="card card-hover flex flex-col overflow-hidden">
          <div class="relative aspect-[4/3] overflow-hidden bg-inkdark">
            <Image
              src={img(o.image)}
              alt={`${o.city} office`}
              class="media-fade absolute inset-0 h-full w-full object-cover"
              widths={[320, 480, 640]}
              sizes="(min-width: 1280px) 25vw, (min-width: 640px) 50vw, 92vw"
              format="webp"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="type-title font-bold text-primary">{o.city}</div>
            <div class="mt-0.5 text-sm text-on-surface">{o.label}</div>
            <p class="mt-2 text-sm leading-relaxed text-muted">{o.address}</p>
            <p class="mt-auto pt-4 text-sm font-semibold text-on-surface">{o.phone}</p>
            <a href={`mailto:${o.email}`} class="text-sm font-semibold text-primary transition duration-200 ease-in-out hover:text-secondary-dark hover:underline">{o.email}</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-surface-container">
    <div class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-12 px-5 py-14 lg:grid-cols-2">
      <div>
        <div class="kicker mb-3">Write to us</div>
        <h2 class="type-headline text-on-surface">Feedback & queries</h2>
        <p class="mt-3 text-muted">
          For programme partnerships, publications, or general enquiries, drop us a line and our team will follow up.
        </p>
        <p class="mt-5 text-on-surface"><strong>Head Office:</strong> 216, Azad Society, Ahmedabad 380015, Gujarat (India)</p>
        <p class="text-on-surface"><strong>Email:</strong> <a href={`mailto:psu_unnati@unnati.org`} class="text-primary transition duration-200 ease-in-out hover:text-secondary-dark hover:underline">psu_unnati@unnati.org</a></p>
        <p class="text-on-surface"><strong>Tel:</strong> +91-79-26746145 · 26733296</p>
      </div>
      <div class="card overflow-hidden">
        <iframe
          src="https://www.google.com/maps?q=216%20Azad%20Society%2C%20Ahmedabad%20380015%2C%20Gujarat&output=embed"
          title="UNNATI Head Office — 216 Azad Society, Ahmedabad"
          class="h-full min-h-[420px] w-full"
          style="border: 0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
