---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
import { anchorName } from "../../data/projects";
import { img } from "../../lib/images";
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} · UNNATI`} description={project.summary} image={project.image}>
  <section class="mx-auto w-full max-w-6xl px-5 pt-6">
    <div class="relative aspect-[4/3] overflow-hidden rounded-2xl shadow-pop sm:aspect-[16/9]">
      <Image
        src={img(project.image)}
        alt={project.title}
        class="absolute inset-0 h-full w-full object-cover object-top"
        widths={[600, 900, 1200, 1600]}
        sizes="100vw"
        format="webp"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/95 via-primary-dark/50 to-primary-dark/10"></div>
      <div class="relative z-10 flex h-full flex-col justify-end px-6 py-10 sm:px-10 sm:py-14">
        <div class="kicker mb-3 text-secondary-light">Key Project</div>
        <h1 class="max-w-3xl text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{project.title}</h1>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="chip">{project.period}</span>
          <span class="chip">{project.support}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-12">
    <div class="mx-auto max-w-3xl">
      <div class="mb-6 flex flex-wrap gap-1.5">
        {project.tags.map((t) => (
          <a
            href={`${base}thematic-anchors/${t}`}
            class="rounded-full bg-saffron px-3 py-1 text-xs font-medium text-charcoal transition duration-200 ease-in-out hover:opacity-90"
          >{anchorName(t)}</a>
        ))}
      </div>

      <p class="mb-8 text-lg leading-relaxed text-on-surface">{project.summary}</p>

      {project.details && project.details.length > 0 && (
        <div class="mb-8 space-y-4">
          {project.details.map((d) => (
            <p class="text-on-surface">{d}</p>
          ))}
        </div>
      )}

      <div class="card p-6 sm:p-8">
        <h2 class="type-headline text-on-surface">Highlights</h2>
        <ul class="mt-4 list-none space-y-3 p-0">
          {project.highlights.map((h) => (
            <li class="relative pl-6 type-body text-on-surface">
              <span class="absolute left-0 top-[0.5em] h-2.5 w-2.5 rounded-full bg-saffron"></span>
              {h}
            </li>
          ))}
        </ul>
      </div>

      {project.gallery && project.gallery.length > 0 && (
        <div class="mt-12">
          <h2 class="type-headline text-on-surface">Photo Gallery</h2>
          <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {project.gallery.map((g) => (
              <Image
                src={img(g)}
                alt=""
                class="aspect-[4/3] w-full rounded-xl object-cover object-top shadow-card"
                widths={[480, 720, 960]}
                sizes="(min-width: 640px) 46vw, 92vw"
                format="webp"
                loading="lazy"
              />
            ))}
          </div>
        </div>
      )}

      <div class="mt-12">
        <a class="btn btn--outlined" href={`${base}thematic-anchors`}>All Thematic Anchors</a>
      </div>
    </div>
  </section>
</Layout>
