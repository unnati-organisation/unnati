---
import Layout from "../../layouts/Layout.astro";
import { readFile } from "node:fs/promises";
import { join, dirname } from "node:path";
import { fileURLToPath } from "node:url";

const base = import.meta.env.BASE_URL;

const __dirname = dirname(fileURLToPath(import.meta.url));
const archivedData = JSON.parse(await readFile(join(__dirname, "../../data/archived-pdfs.json"), "utf8"));
---

<Layout title="Archived Documents · UNNATI" description="Archived publications, newsletters, reports and other documents from UNNATI's repository.">
  <section class="relative overflow-hidden bg-surface-container">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(circle at 88% 8%, rgba(107,64,40,0.12), transparent 46%), radial-gradient(circle at 4% 100%, rgba(107,64,40,0.08), transparent 40%);"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 py-14">
      <div class="kicker mb-4">Archived</div>
      <h1 class="max-w-3xl text-4xl font-bold text-on-surface sm:text-5xl">Archived Documents</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        Historical publications, newsletters, reports and other documents no longer featured on the main Resources or Accountability pages.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-12">
    {Object.entries(archivedData).map(([category, data]) => (
      <div class="mb-12">
        <div class="kicker mb-2">{category}</div>
        <p class="mb-4 text-sm text-muted">{data.description}</p>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {data.files.map((file) => (
            <a href={`${base}${file.path}`} target="_blank" rel="noopener noreferrer" class="card card-hover block p-4">
              <div class="flex items-center gap-3">
                <span class="text-lg" aria-hidden="true">&#128196;</span>
                <div class="flex-1 min-w-0">
                  <span class="type-title text-on-surface text-sm font-semibold block truncate">{file.name}</span>
                  <span class="text-xs text-muted block">PDF</span>
                </div>
                <span class="text-xs font-bold text-secondary-dark shrink-0">Open &#8599;</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
