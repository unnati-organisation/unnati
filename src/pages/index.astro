---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import HeroSlider from "../components/HeroSlider.astro";
import { anchors } from "../data/anchors";
import { projects } from "../data/projects";
import { img } from "../lib/images";

const base = import.meta.env.BASE_URL;
const heroSlides = [
  {
    image: "/images/slide-climate.jpg",
    tag: "Water & Livelihoods",
    title: "Building Climate-Resilient Agriculture in the Thar Desert",
    sub: "Community-led adaptation for food and water security in Western Rajasthan.",
    cta: { label: "Explore Our Work", href: "/thematic-anchors" },
  },
  {
    image: "/images/hero-water.jpg",
    tag: "Water Security",
    title: "Reviving nadis, orans and gauchars across 150 villages",
    sub: "Jal Saheli women's collectives lead eco-sensitive planning and water budgeting.",
    cta: { label: "Marudhar Mein Jal Swavlamban", href: "/thematic-anchors/social-determinants-of-disaster-risk-reduction" },
  },
  {
    image: "/images/hero-women-farmers.jpg",
    tag: "Women's Leadership",
    title: "Empowering Women Farmers in Western Rajasthan",
    sub: "Sustainable agriculture across the Thar desert.",
    cta: { label: "Social Inclusion & Empowerment", href: "/thematic-anchors/social-inclusion-and-empowerment" },
  },
  {
    image: "/images/hero-panchayat.jpg",
    tag: "Social Accountability",
    title: "Citizen leaders holding institutions accountable",
    sub: "Social audits, citizen report cards and RTI camps across Gujarat and Rajasthan.",
    cta: { label: "Civic Leadership & Governance", href: "/thematic-anchors/civic-leadership-governance-and-social-accountability" },
  },
];

const stats = [
  { num: 2, suffix: "", label: "States" },
  { num: 15, suffix: "", label: "Districts" },
  { num: 350, suffix: "+", label: "Villages" },
  { num: "100,000", suffix: "+", label: "Households supported" },
  { num: 70, suffix: "+", label: "Gram panchayats strengthened" },
];
---

<Layout title="UNNATI · Organisation for Development Education">
  <HeroSlider slides={heroSlides} />

  <!-- Impact at a glance -->
  <section class="bg-inkdark">
    <div class="mx-auto w-full max-w-6xl px-5 py-10">
      <div class="mx-auto mb-6 max-w-2xl text-center">
        <div class="kicker mb-3 text-saffron-300">Impact at a glance</div>
        <h2 class="text-3xl font-bold text-white sm:text-4xl">Three decades of grassroots work</h2>
      </div>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
        {stats.map((s) => (
          <div class="border-t-2 border-white/10 pt-6 text-center lg:border-t-0 lg:border-l lg:border-l-white/10 lg:pt-0 lg:pl-8 lg:first:border-l-0 lg:first:pl-0">
            <span class="block text-4xl font-bold leading-none tracking-tight text-saffron-400 lg:text-5xl">{s.num}{s.suffix}</span>
            <span class="mt-2 block text-sm text-zinc-400">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Purpose -->
  <section class="mx-auto w-full max-w-6xl px-5 py-12">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
      <div class="relative pb-12 pr-8">
        <div class="absolute bottom-0 right-0 h-[72%] w-[72%] rounded-3xl bg-saffron-100" aria-hidden="true"></div>
        <Image
          src={img("/images/purpose-field.jpg")}
          alt="UNNATI field work"
          class="relative aspect-[4/3] w-[86%] rounded-2xl object-cover object-top shadow-pop"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 42vw, 92vw"
          format="webp"
          loading="lazy"
        />
        <Image
          src={img("/images/purpose-overlay.jpg")}
          alt="Women farmers in the Thar desert"
          class="absolute bottom-0 right-0 aspect-square w-[52%] rounded-2xl border-4 border-paper object-cover object-top shadow-pop"
          widths={[320, 480, 720]}
          sizes="30vw"
          format="webp"
          loading="lazy"
        />
      </div>

      <div>
        <div class="kicker mb-3">Our Purpose</div>
        <h2 class="text-3xl font-bold text-charcoal sm:text-4xl">Towards an inclusive and democratic society.</h2>
        <p class="mt-4 text-xl font-medium leading-snug text-charcoal">
          UNNATI — Organisation for Development Education is a voluntary non-profit, registered in 1990.
        </p>
        <p class="mt-3 text-muted">
          We work to promote social inclusion and democratic governance so that vulnerable sections of
          society — dalits, tribals, women and persons with disabilities — participate effectively in
          mainstream development and decision-making.
        </p>
        <ul class="mt-6 space-y-3">
          <li class="flex items-start gap-3 text-charcoal">
            <span class="mt-1 text-xs text-saffron-600">◆</span>
            Participatory development education and capacity building
          </li>
          <li class="flex items-start gap-3 text-charcoal">
            <span class="mt-1 text-xs text-saffron-600">◆</span>
            Grassroots mobilisation across Gujarat, Rajasthan and Delhi
          </li>
          <li class="flex items-start gap-3 text-charcoal">
            <span class="mt-1 text-xs text-saffron-600">◆</span>
            Research, advocacy and policy engagement at every level
          </li>
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn--primary btn--shine" href={`${base}about`}>About UNNATI</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Thematic anchors -->
  <section class="bg-saffron-50/70">
    <div class="mx-auto w-full max-w-6xl px-5 py-12">
      <div class="max-w-2xl">
        <div class="kicker mb-3">What We Do</div>
        <h2 class="text-3xl font-bold text-charcoal sm:text-4xl">Three Thematic Anchors</h2>
        <p class="mt-2 text-muted">All our work is carried out through three programme centres, from grassroots to policy level.</p>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
        {anchors.map((a) => (
          <a href={`${base}thematic-anchors/${a.slug}`} class="card card-hover group flex flex-col overflow-hidden">
            <div class="relative aspect-[4/3] overflow-hidden bg-charcoal">
              <Image
                src={img(a.image)}
                alt={a.title}
                class="media-fade absolute inset-0 h-full w-full object-cover object-top"
                widths={[400, 640, 960]}
                sizes="(min-width: 768px) 33vw, 92vw"
                format="webp"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <div class="kicker mb-2 text-xs">{a.tagline}</div>
              <h3 class="mb-2 text-xl text-charcoal">{a.title}</h3>
              <p class="mb-4 flex-1 text-sm text-muted">{a.intro}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-saffron-600 transition duration-200 ease-in-out group-hover:gap-2.5">
                Explore <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Current projects teaser -->
  <section class="mx-auto w-full max-w-6xl px-5 py-12">
    <div class="max-w-2xl">
      <div class="kicker mb-3">In the Field</div>
      <h2 class="text-3xl font-bold text-charcoal sm:text-4xl">Current Projects</h2>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      {projects.slice(0, 2).map((p) => (
        <a class="card card-hover group flex flex-col overflow-hidden" href={`${base}thematic-anchors/${p.tags[0]}`}>
          <div class="relative aspect-[16/9] overflow-hidden bg-charcoal">
            <Image
              src={img(p.image)}
              alt={p.title}
              class="media-fade absolute inset-0 h-full w-full object-cover object-top"
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 768px) 46vw, 92vw"
              format="webp"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="mb-3 flex flex-wrap gap-2">
              <span class="chip">{p.period}</span>
              <span class="chip">{p.support}</span>
            </div>
            <h3 class="mb-2 text-xl text-charcoal">{p.title}</h3>
            <p class="mb-4 flex-1 text-sm text-muted">{p.summary}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-saffron-600 transition duration-200 ease-in-out group-hover:gap-2.5">
              Explore <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Partners -->
  <section class="bg-saffron-50/70 py-10">
    <div class="mx-auto w-full max-w-6xl px-5 text-center">
      <div class="kicker mb-4">Supporters & Partners</div>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <span class="rounded-full border border-line bg-white px-5 py-2.5 text-sm font-semibold text-charcoal shadow-card transition duration-200 ease-in-out hover:-translate-y-0.5 hover:border-saffron-500 hover:text-saffron-600">European Commission</span>
        <span class="rounded-full border border-line bg-white px-5 py-2.5 text-sm font-semibold text-charcoal shadow-card transition duration-200 ease-in-out hover:-translate-y-0.5 hover:border-saffron-500 hover:text-saffron-600">GIZ</span>
        <span class="rounded-full border border-line bg-white px-5 py-2.5 text-sm font-semibold text-charcoal shadow-card transition duration-200 ease-in-out hover:-translate-y-0.5 hover:border-saffron-500 hover:text-saffron-600">Government of Rajasthan</span>
        <span class="rounded-full border border-line bg-white px-5 py-2.5 text-sm font-semibold text-charcoal shadow-card transition duration-200 ease-in-out hover:-translate-y-0.5 hover:border-saffron-500 hover:text-saffron-600">Government of Gujarat</span>
        <span class="rounded-full border border-line bg-white px-5 py-2.5 text-sm font-semibold text-charcoal shadow-card transition duration-200 ease-in-out hover:-translate-y-0.5 hover:border-saffron-500 hover:text-saffron-600">PRIA</span>
      </div>
    </div>
  </section>
</Layout>
