---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { board } from "../data/site";
import { img } from "../lib/images";

const boardJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: board.map((m, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Person",
      name: m.name,
      jobTitle: m.role,
      ...(m.bio?.trim() ? { description: m.bio.replace(/<[^>]*>/g, "") } : {}),
    },
  })),
};

const timeline = [
  {
    num: "01",
    icon: "◎",
    year: "1990–1993",
    title: "Inception of UNNATI",
    image: "/images/purpose-field.jpg",
    alt: "UNNATI field work in its early years",
    blurb: "Capacity development of Social Action Groups, with early studies on the impact of liberalisation on poor households and drought management.",
    tags: ["Social Action Groups", "Liberalisation study", "Drought management"],
  },
  {
    num: "02",
    icon: "⛊",
    year: "1994–2000",
    title: "Strengthening Panchayati Raj Institutions",
    image: "/images/hero-panchayat.jpg",
    alt: "Gram panchayat strengthening",
    blurb: "Continued support on rights and entitlements, promoted the Dalit Adhikar Abhiyan and began programme operations in Western Rajasthan.",
    tags: ["Dalit Adhikar Abhiyan", "Western Rajasthan", "Panchayat Resource Centres", "Voter awareness"],
  },
  {
    num: "03",
    icon: "▲",
    year: "2001–2008",
    title: "Formal entry into Disaster Risk Reduction",
    image: "/images/theme-cmdrr.jpg",
    alt: "Community-based disaster risk reduction",
    blurb: "Strategic shift to an issue-based educational organisation, promoting rural vernacular safe housing and supporting Gujarat's gender policy.",
    tags: ["Rural safe housing", "Gender policy 2004", "Strategic shift"],
  },
  {
    num: "04",
    icon: "✦",
    year: "2009–2016",
    title: "Partnership with Government to scale impact",
    image: "/images/theme-sa-social.jpg",
    alt: "Social accountability in public programmes",
    blurb: "State-wide MGNREGA social audit, SATCOM trainings for all Gram Panchayats with SIRD, and technical support to NDMA.",
    tags: ["MGNREGA social audit", "SATCOM trainings", "JnNURM", "NDMA"],
  },
  {
    num: "05",
    icon: "◈",
    year: "2017–2025",
    title: "Field operations for vulnerability reduction",
    image: "/images/hero-water.jpg",
    alt: "Community water resources in western Rajasthan",
    blurb: "Four block-level field operations, a governance-based development model through GP–CBO social compacts, and the Inter-Agency Group for disaster response.",
    tags: ["Last-mile programmes", "GP–CBO social compact", "Inter-Agency Group"],
  },
];

const vms = [
  {
    num: "01",
    icon: "◎",
    kicker: "Where we are headed",
    title: "Vision",
    image: "/images/vision.jpg",
    alt: "Village assembly",
    body: "Towards building an inclusive and democratic society.",
  },
  {
    num: "02",
    icon: "✦",
    kicker: "What we are here to do",
    title: "Mission",
    image: "/images/mission.jpg",
    alt: "Women farmers",
    body: "To promote social inclusion and democratic governance so that dalits, tribals, women and persons with disabilities are empowered to participate in development and decision-making.",
  },
  {
    num: "03",
    icon: "▲",
    kicker: "How we work",
    title: "Strategy",
    image: "/images/strategy.jpg",
    alt: "Thar desert commons",
    body: "An issue-based, strategic educational support organisation working in Western India with people's collectives, NGOs, elected representatives in local governance and the government. Collaborative research, public education, advocacy, direct field-level mobilisation and implementation with multiple stakeholders are the key instruments of our work — spanning from the grassroots to the policy level in ensuring the basic rights of citizens.",
  },
];
---

<Layout title="About Us · UNNATI" description="Vision, mission and 35 years of UNNATI's work for social inclusion and democratic governance.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(boardJsonLd)} />
  <section class="relative overflow-hidden bg-surface-container">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(circle at 88% 8%, rgba(107,64,40,0.12), transparent 46%), radial-gradient(circle at 4% 100%, rgba(107,64,40,0.08), transparent 40%);"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 py-14">
      <div class="kicker mb-4">About Us</div>
      <h1 class="max-w-3xl text-4xl font-bold text-on-surface sm:text-5xl">Three decades enabling participation.</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        UNNATI is a voluntary non-profit promoting social inclusion and democratic governance so the vulnerable
        participate decisively in mainstream development.
      </p>
    </div>
  </section>

  <!-- Vision / Mission / Strategy -->
  <section class="mx-auto w-full max-w-6xl px-5 py-12">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {vms.map((v) => (
        <article class="card card-hover flex flex-col overflow-hidden">
          <div class="relative h-48 overflow-hidden">
            <Image
              src={img(v.image)}
              alt={v.alt}
              class="media-fade absolute inset-0 h-full w-full object-cover object-top"
              widths={[400, 640, 960]}
              sizes="(min-width: 768px) 33vw, 92vw"
              format="webp"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/90 via-primary-dark/30 to-transparent"></div>
            <span class="absolute left-3 top-3 rounded-full bg-secondary-container px-2.5 py-1 text-xs font-bold tracking-widest text-on-secondary-container">{v.num}</span>
            <span class="absolute right-3 top-2 text-xl text-white/90">{v.icon}</span>
            <span class="absolute bottom-3 left-4 type-label text-secondary-light">{v.kicker}</span>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="mb-3 type-title text-on-surface">{v.title}</h3>
            <div class="mb-3 h-0.5 w-10 rounded bg-primary"></div>
            <p class="mb-0 type-body text-muted">{v.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- History timeline -->
  <section class="bg-primary-dark">
    <div class="mx-auto w-full max-w-6xl px-5 py-14">
      <div class="kicker mb-3 text-secondary-light">Our Journey</div>
      <h2 class="type-headline text-white">History</h2>
      <p class="mt-3 text-zinc-300">
        Over three decades, UNNATI has evolved from providing generic capacity-building support to becoming a
        <strong class="font-semibold text-secondary-light"> technical knowledge partner</strong> for state and national
        governments. Its first decade focused on laying the groundwork for local self-governance and
        <strong class="font-semibold text-secondary-light"> rights-based movements</strong>. A strategic shift occurred between 2001 and
        2008, when the organization transitioned into an <strong class="font-semibold text-secondary-light">issue-based educational
        body</strong> focusing on disaster risk reduction, gender mainstreaming, and social accountability. By 2009, it
        adopted a <strong class="font-semibold text-secondary-light"> governance-based development model</strong> centered on forming
        <strong class="font-semibold text-secondary-light"> social compacts</strong> between community-based organizations and Gram
        Panchayats. Currently, UNNATI scales its impact through systemic partnerships with the governments and
        networks of civil society organisations.
      </p>
      <div class="relative mt-10">
        <div class="absolute bottom-0 left-5 top-0 w-0.5 bg-white/40 lg:left-1/2" aria-hidden="true"></div>
        {timeline.map((t, i) => (
          <div class="relative mb-6 lg:grid lg:grid-cols-2 lg:gap-12">
            <div class="absolute left-5 top-1/2 z-10 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-surface bg-saffron shadow-card lg:left-1/2" aria-hidden="true"></div>
            <span class={i % 2 === 0
              ? "absolute left-8 top-1/2 z-20 -translate-y-1/2 whitespace-nowrap rounded-lg bg-surface/85 px-2 py-0.5 text-xl font-bold text-primary backdrop-blur-sm lg:left-1/2 lg:translate-x-5 lg:bg-transparent lg:px-0 lg:py-0 lg:backdrop-blur-none lg:text-2xl lg:text-secondary-light"
              : "absolute left-8 top-1/2 z-20 -translate-y-1/2 whitespace-nowrap rounded-lg bg-surface/85 px-2 py-0.5 text-xl font-bold text-primary backdrop-blur-sm lg:left-1/2 lg:-translate-x-[calc(100%+1.25rem)] lg:bg-transparent lg:px-0 lg:py-0 lg:backdrop-blur-none lg:text-2xl lg:text-secondary-light"}
            >{t.year}</span>
            <div class={`pl-12 lg:pl-0 ${i % 2 === 0 ? "lg:col-start-1" : "lg:col-start-2"}`}>
              <article class="card flex overflow-hidden">
                <div class="relative w-28 shrink-0 bg-inkdark sm:w-36 lg:w-40">
                  <Image
                    src={img(t.image)}
                    alt={t.alt}
                    class="absolute inset-0 h-full w-full object-cover object-top"
                    widths={[240, 360, 480]}
                    sizes="(min-width: 1024px) 160px, (min-width: 640px) 144px, 112px"
                    format="webp"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/90 via-primary-dark/25 to-transparent"></div>
                  <span class="absolute bottom-2 left-2 rounded-full bg-secondary-container px-2 py-0.5 text-[10px] font-bold text-on-secondary-container">{t.num}</span>
                  <span class="absolute right-2 top-2 text-2xl text-secondary-light">{t.icon}</span>
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <h3 class="type-title text-on-surface">{t.title}</h3>
                  <div class="mt-2 mb-2 h-0.5 w-8 rounded bg-primary"></div>
                  <p class="mb-3 flex-1 type-body text-muted">{t.blurb}</p>
                  <div class="flex flex-wrap gap-1.5">
                    {t.tags.map((tag) => <span class="rounded-full bg-primary-container px-3 py-1 text-xs font-medium text-on-primary-container">{tag}</span>)}
                  </div>
                </div>
              </article>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Board -->
  <section class="mx-auto w-full max-w-6xl px-5 py-14">
    <div class="max-w-2xl">
      <div class="kicker mb-3">Leadership</div>
      <h2 class="type-headline text-on-surface">Board Members</h2>
      <p class="mt-2 text-muted">Guiding UNNATI's governance and direction.</p>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {board.map((m, i) => (
        <div class="group relative grid aspect-[3/5] grid-rows-[1fr_auto] overflow-hidden rounded-2xl bg-surface-container-low shadow-card ring-1 ring-outline-variant transition duration-200 ease-in-out hover:-translate-y-1 hover:shadow-pop">
          <div class="relative min-h-0 overflow-hidden">
            <Image
              src={img(m.image)}
              alt={m.name}
              class="absolute inset-0 h-full w-full object-cover"
              widths={[360, 480, 720]}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              format="webp"
              loading="lazy"
            />
          </div>
          <div class="p-5">
            <h4 class="mb-1 type-title text-on-surface">{m.name}</h4>
            <div class="text-sm font-bold text-secondary-dark">{m.role}</div>
            <div class="mt-1 text-xs leading-relaxed text-muted">{m.address}</div>
            {m.bio?.trim() && <div class="mt-3 text-xs font-semibold text-primary">View bio →</div>}
          </div>
          {m.bio?.trim() && (
            <button
              type="button"
              class="absolute inset-0 h-full w-full cursor-pointer rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary group-hover:ring-2 group-hover:ring-primary"
              data-bio-open={`bio-dialog-${i}`}
              aria-haspopup="dialog"
              aria-label={`View bio of ${m.name}`}
            ></button>
          )}
        </div>
      ))}
    </div>

    {board.map((m, i) =>
      m.bio?.trim() ? (
        <dialog
          id={`bio-dialog-${i}`}
          class="m-auto w-[min(92vw,36rem)] max-h-[85vh] overflow-y-auto rounded-2xl bg-surface p-0 shadow-pop backdrop:bg-black/60"
          aria-label={`${m.name} bio`}
        >
          <div class="relative flex flex-col sm:flex-row">
            <button
              type="button"
              class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-surface/85 text-on-surface transition duration-200 ease-in-out hover:bg-surface-container"
              data-bio-close
              aria-label="Close bio"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <div class="relative h-52 w-full shrink-0 overflow-hidden bg-surface-container sm:h-auto sm:w-52">
              <Image
                src={img(m.image)}
                alt={m.name}
                class="absolute inset-0 h-full w-full object-cover object-top"
                widths={[320, 480]}
                sizes="(min-width: 640px) 208px, 100vw"
                format="webp"
              />
            </div>
            <div class="flex-1 p-6 pr-14 sm:pr-6">
              <h3 class="text-lg font-bold text-on-surface">{m.name}</h3>
              <div class="mt-0.5 text-sm font-bold text-secondary-dark">{m.role}</div>
              <div class="mt-1 text-xs leading-relaxed text-muted">{m.address}</div>
              <div class="mt-3 h-0.5 w-10 rounded bg-primary"></div>
              <div class="mt-3 text-sm leading-relaxed text-on-surface-variant" set:html={m.bio}></div>
            </div>
          </div>
        </dialog>
      ) : null,
    )}
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-bio-open]").forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.bioOpen ?? "") as HTMLDialogElement | null;
    if (!dialog) return;
    btn.addEventListener("click", () => {
      dialog.showModal();
      document.body.style.overflow = "hidden";
    });
    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-bio-close]").forEach((btn) => {
    btn.addEventListener("click", () => {
      (btn.closest("dialog") as HTMLDialogElement | null)?.close();
    });
  });
</script>
