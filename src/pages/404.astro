---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found · UNNATI"
  description="The page you are looking for could not be found."
>
  <section class="relative overflow-hidden bg-inkdark">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(circle at 88% 8%, rgba(229,142,38,0.14), transparent 46%), radial-gradient(circle at 4% 100%, rgba(229,142,38,0.1), transparent 40%);"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 py-24 text-center">
      <div class="kicker mb-4 text-saffron-300">404</div>
      <h1 class="mx-auto max-w-2xl text-4xl font-bold text-white sm:text-5xl">This page has moved or no longer exists.</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-zinc-300">
        The link may be outdated. Explore our thematic anchors, resources or contact us directly.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn--primary btn--shine" href="/">Back to Home</a>
        <a class="btn btn--ghost" href="/resources">Browse Resources</a>
        <a class="btn btn--ghost" href="/contact">Contact UNNATI</a>
      </div>
    </div>
  </section>
</Layout>
