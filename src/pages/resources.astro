---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import {
  publications,
  pubLinks,
  themeOrder,
  themeMeta,
  mediaOf,
  mediaLabels,
  type PubMedia,
  type PubFormat,
  type Publication,
} from "../data/resources";
import { img, hasImage } from "../lib/images";

const items: Publication[] = publications.map((p) => ({ ...p, url: p.url ?? pubLinks[p.id] }));
const medias: PubMedia[] = ["publication", "audio"];
const mediaPill = (p: Publication) => mediaLabels[mediaOf(p.format)];
const portrait: Set<PubFormat> = new Set(["book", "leaflet"]);
const iconByFormat: Record<PubFormat, string> = {
  book: "▤",
  leaflet: "✳",
  report: "❐",
  newsletter: "✎",
  video: "▶",
};
const langs = "En · हिंदी · ગુજરાતી";
---

<Layout
  title="Resources · UNNATI"
  description="Searchable publications from UNNATI's knowledge resource centre — books, reports, leaflets, newsletters and films — by theme and language."
>
  <section class="relative overflow-hidden bg-inkdark">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(circle at 88% 8%, rgba(229,142,38,0.14), transparent 46%), radial-gradient(circle at 4% 100%, rgba(229,142,38,0.1), transparent 40%);"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 py-12">
      <div class="kicker mb-4 text-saffron-300">Knowledge Resource Centre</div>
      <h1 class="max-w-3xl text-4xl font-bold text-white sm:text-5xl">Resources</h1>
      <p class="mt-5 max-w-2xl text-lg text-zinc-300">
        Field learning consolidated and disseminated in print, digital and audio-visual forms for wider sharing.
        Browse by theme, format or language — or search the catalogue.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-12">
    <div class="card space-y-6 p-6">
      <div class="relative">
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-lg text-muted" aria-hidden="true">⌕</span>
        <input
          id="resSearch"
          type="search"
          placeholder="Search publications — e.g. water, panchayat, disability, MGNREGA…"
          autocomplete="off"
          class="field pl-10"
        />
      </div>

      <div>
        <span class="mb-2 block text-xs font-extrabold uppercase tracking-[0.12em] text-muted">Theme</span>
        <div class="flex flex-wrap gap-2" id="themeFilters">
          <button class="filter-chip active" data-theme="all">All themes</button>
          {themeOrder.map((t) => <button class="filter-chip" data-theme={t}>{themeMeta[t].label}</button>)}
        </div>
      </div>

      <div>
        <span class="mb-2 block text-xs font-extrabold uppercase tracking-[0.12em] text-muted">Format</span>
        <div class="flex flex-wrap gap-2" id="formatFilters">
          <button class="filter-chip active" data-format="all">All formats</button>
          {medias.map((m) => <button class="filter-chip" data-format={m}>{mediaLabels[m]}</button>)}
        </div>
      </div>

      <div>
        <span class="mb-2 block text-xs font-extrabold uppercase tracking-[0.12em] text-muted">Language</span>
        <div class="flex flex-wrap gap-2" id="langFilters">
          <button class="filter-chip active" data-lang="all">All</button>
          <button class="filter-chip" data-lang="English">English</button>
          <button class="filter-chip" data-lang="Hindi">हिंदी</button>
          <button class="filter-chip" data-lang="Gujarati">ગુજરાતી</button>
        </div>
      </div>
    </div>

    <p class="mb-8 mt-8 text-sm text-muted" id="resCount"></p>

    <div class="res-grid grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6" id="resGrid">
      {items.map((pub) => {
        const isPortrait = portrait.has(pub.format);
        const cls = ["pub-card", "card", "card-hover", "flex", "flex-col", "overflow-hidden"];
        if (pub.url) cls.push("pub-card--link");
        const coverCls = isPortrait ? "aspect-[3/4]" : "aspect-[16/10]";
        const inner = (
          <>
            <div class={`relative overflow-hidden bg-charcoal ${coverCls}`}>
              {hasImage(pub.image) ? (
                <Image
                  src={img(pub.image)}
                  alt={pub.title}
                  class="media-fade absolute inset-0 h-full w-full object-cover"
                  widths={[240, 360, 480]}
                  sizes="(min-width: 1024px) 15vw, (min-width: 768px) 22vw, (min-width: 640px) 30vw, 46vw"
                  format="webp"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full flex-col items-center justify-center gap-2 bg-gradient-to-br from-charcoal to-charcoal-2 p-4 text-center text-white/85">
                  <span class="text-2xl text-saffron-500">{iconByFormat[pub.format]}</span>
                  <span class="max-w-[88%] text-[0.7rem] font-bold uppercase tracking-[0.14em] text-white/60">{mediaPill(pub)}</span>
                </div>
              )}
              <div class="absolute left-2 top-2 z-10 flex flex-wrap gap-1">
                <span class="rounded-full bg-saffron-500 px-2 py-0.5 text-[0.6rem] font-extrabold uppercase tracking-[0.08em] text-charcoal">{mediaPill(pub)}</span>
                <span class="rounded-full bg-white/90 px-2 py-0.5 text-[0.6rem] font-extrabold uppercase tracking-[0.08em] text-charcoal">{pub.badge}</span>
              </div>
              {pub.url && <span class="absolute bottom-2 right-2 z-10 rounded-full bg-saffron-500 px-2 py-1 text-[0.62rem] font-extrabold text-charcoal">{mediaOf(pub.format) === "audio" ? "▶ Play" : "⤓ Open PDF"}</span>}
            </div>
            <div class="flex flex-1 flex-col p-4">
              <h3 class="mb-1.5 text-base leading-snug text-charcoal">{pub.title}</h3>
              <p class="mb-3 flex-1 text-sm text-muted">{pub.description}</p>
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-semibold text-charcoal">
                  {pub.languages.length > 0 ? pub.languages.join(" · ") : langs}
                </span>
                {pub.year && <span class="text-xs font-bold text-muted">{pub.year}</span>}
              </div>
            </div>
          </>
        );
        const attrs = {
          "data-theme": pub.themes.join(" "),
          "data-format": mediaOf(pub.format),
          "data-lang": pub.languages.join(" "),
        };
        return pub.url ? (
          <a href={pub.url} target="_blank" rel="noopener noreferrer" class={cls.join(" ")} {...attrs}>{inner}</a>
        ) : (
          <article class={cls.join(" ")} {...attrs}>{inner}</article>
        );
      })}
    </div>

    <div class="hidden border border-dashed border-line py-14 text-center text-muted" id="resEmpty">
      <p class="mb-1 font-semibold text-charcoal">No publications match your filters.</p>
      <p class="mb-0">Try removing a filter or adjusting your search.</p>
    </div>
  </section>

  <section class="bg-inkdark">
    <div class="mx-auto w-full max-w-3xl px-5 py-12 text-center">
      <div class="kicker mb-3 text-saffron-300">Multilingual</div>
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Publications in Hindi & Gujarati</h2>
      <p class="mt-4 text-zinc-300">
        Core resources are available in हिंदी, ગુજરાતી and English editions — including Vichar, scheme
        leaflets and the women's movement book series. Publications are curated by theme and topic for easy access.
      </p>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const cards = Array.from(document.querySelectorAll("#resGrid .pub-card"));
    const countEl = document.getElementById("resCount");
    const emptyEl = document.getElementById("resEmpty");
    const search = document.getElementById("resSearch");
    const state = { theme: "all", format: "all", lang: "all", q: "" };

    const apply = () => {
      let shown = 0;
      const term = state.q.trim().toLowerCase();
      for (const card of cards) {
        const themes = (card.dataset.theme || "").split(" ");
        const format = card.dataset.format || "";
        const langs = (card.dataset.lang || "").toLowerCase();
        const text = (card.textContent || "").toLowerCase();
        let ok = true;
        if (state.theme !== "all" && !themes.includes(state.theme)) ok = false;
        if (ok && state.format !== "all" && format !== state.format) ok = false;
        if (ok && state.lang !== "all" && !langs.includes(state.lang.toLowerCase())) ok = false;
        if (ok && term && !text.includes(term)) ok = false;
        card.style.display = ok ? "" : "none";
        if (ok) shown++;
      }
      countEl.textContent = `Showing ${shown} of ${cards.length} publications`;
      emptyEl.classList.toggle("visible", shown === 0);
    };

    const bindGroup = (id, key) => {
      document.querySelectorAll(`#${id} .filter-chip`).forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll(`#${id} .filter-chip`).forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          state[key] = btn.dataset[key];
          apply();
        });
      });
    };

    bindGroup("themeFilters", "theme");
    bindGroup("formatFilters", "format");
    bindGroup("langFilters", "lang");

    search.addEventListener("input", () => {
      state.q = search.value;
      apply();
    });

    apply();
  })();
</script>
