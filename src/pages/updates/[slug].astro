---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { updates } from "../../data/updates";
import { img } from "../../lib/images";
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return updates.map((u) => ({
    params: { slug: u.slug },
    props: { update: u },
  }));
}

const { update } = Astro.props;
---

<Layout title={`${update.title} · UNNATI`} description={update.summary} image={update.images[0]}>
  <section class="mx-auto w-full max-w-6xl px-5 pt-6">
    <div class="relative aspect-[4/3] overflow-hidden rounded-2xl shadow-pop sm:aspect-[16/9]">
      <Image
        src={img(update.images[0])}
        alt={update.title}
        class="absolute inset-0 h-full w-full object-cover object-top"
        widths={[600, 900, 1200, 1600]}
        sizes="100vw"
        format="webp"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/95 via-primary-dark/50 to-primary-dark/10"></div>
      <div class="relative z-10 flex h-full flex-col justify-end px-6 py-10 sm:px-10 sm:py-14">
        <div class="kicker mb-3 text-secondary-light">Update</div>
        <h1 class="max-w-3xl text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{update.title}</h1>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="chip">{update.date}</span>
          {update.venue && <span class="chip">{update.venue}</span>}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-12">
    <div class="mx-auto max-w-3xl">
      <p class="mb-8 text-lg leading-relaxed text-on-surface">{update.summary}</p>

      <div class="mb-8 space-y-4">
        {update.details.map((d) => (
          <p class="text-on-surface">{d}</p>
        ))}
      </div>

      {update.video && (
        <div class="card mb-8 overflow-hidden p-0">
          <video
            controls
            class="aspect-video w-full bg-black object-contain"
            poster={img(update.poster ?? update.images[0]).src}
          >
            <source src={update.video} type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
      )}

      {update.brochure && (
        <div class="mb-8">
          <a class="btn btn--primary" href={`${base}${update.brochure.replace(/^\//, "")}`} target="_blank" rel="noopener">
            Download Brochure
          </a>
        </div>
      )}

      {update.images.length > 1 && (
        <div class="mt-12">
          <h2 class="type-headline text-on-surface">Photo Gallery</h2>
          <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {update.images.slice(1).map((g) => (
              <Image
                src={img(g)}
                alt=""
                class="aspect-[4/3] w-full rounded-xl object-cover object-top shadow-card"
                widths={[480, 720, 960]}
                sizes="(min-width: 640px) 46vw, 92vw"
                format="webp"
                loading="lazy"
              />
            ))}
          </div>
        </div>
      )}

      <div class="mt-12">
        <a class="btn btn--outlined" href={`${base}updates`}>All Updates</a>
      </div>
    </div>
  </section>
</Layout>
