---
import { Image } from "astro:assets";
import { img } from "../lib/images";

interface Slide {
  image: string;
  tag: string;
  title: string;
  sub?: string;
  cta?: { label: string; href: string };
}

const { slides } = Astro.props as { slides: Slide[] };
const base = import.meta.env.BASE_URL;
---

<div class="hero-slider bg-surface" data-hero>
  {slides.map((s, i) => (
    <section class="flex overflow-hidden py-10 lg:py-14" data-slide={i}>
      <div class="mx-auto w-full max-w-6xl px-5">
        <div class="relative min-h-[440px] overflow-hidden rounded-[28px] shadow-pop sm:min-h-[520px]">
          <Image
            src={img(s.image)}
            alt={s.title}
            class="absolute inset-0 h-full w-full object-cover object-top"
            widths={[600, 900, 1200, 1600, 2000]}
            sizes="(min-width: 1024px) 75rem, 100vw"
            format="webp"
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/95 via-primary-dark/55 to-primary-dark/10"></div>
          <div class="relative z-10 flex min-h-[440px] flex-col justify-end px-6 py-8 sm:min-h-[520px] sm:px-12 sm:py-12">
            <div class="kicker mb-5 flex! items-center gap-2 text-secondary-light">
              <span class="h-2 w-2 rounded-full bg-saffron"></span>
              {s.tag}
            </div>
            {i === 0 ? (
              <h1 class="mb-4 max-w-3xl text-3xl font-bold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl">{s.title}</h1>
            ) : (
              <h2 class="mb-4 max-w-3xl text-3xl font-bold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl">{s.title}</h2>
            )}
            {s.sub && <p class="mb-8 max-w-2xl text-base text-zinc-200 sm:text-lg">{s.sub}</p>}
            <div class="flex flex-wrap gap-3">
              {s.cta && <a class="btn btn--on-dark" href={`${base}${s.cta.href.replace(/^\//, "")}`}>{s.cta.label}</a>}
              <a class="btn btn--ghost" href={`${base}about`}>Our Story</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <div class="mx-auto flex w-full max-w-6xl justify-end px-5 pb-4">
    <div class="flex gap-2">
      {slides.map((_, i) => (
        <button class={i === 0 ? "hero-dot active" : "hero-dot"} type="button" data-dot={i} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
  </div>
</div>

<script>
  const root = document.querySelector("[data-hero]");
  if (root) {
    const slidesArr = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    let idx = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      idx = n;
      slidesArr.forEach((el, i) => { (el as HTMLElement).style.display = i === idx ? "flex" : "none"; });
      dots.forEach((d, i) => d.classList.toggle("active", i === idx));
    };
    dots.forEach((d, i) => d.addEventListener("click", () => { show(i); restart(); }));
    const restart = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show((idx + 1) % slidesArr.length), 6000);
    };
    show(0);
    restart();
  }
</script>
